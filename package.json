{
    "name": "spessafont",
    "productName": "SpessaFont",
    "description": "Online and open source SF2/DLS sound bank editor",
    "author": {
        "name": "spessasus",
        "email": "spesekspesek@gmail.com"
    },
    "homepage": "https://github.com/spessasus/SpessaFont",
    "repository": "github:spessasus/SpessaFont",
    "private": true,
    "version": "2.0.2",
    "type": "module",
    "main": "electron/main.js",
    "scripts": {
        "dev": "vite",
        "build": "npm run test:types && npm test && npm run build:fast",
        "build:fast": "vite build",
        "test:types": "eslint src electron public vite.config.ts && node node_modules/typescript7/bin/tsc -b",
        "preview": "vite preview",
        "debug": "debug_scripts/local_core.sh",
        "release": "debug_scripts/npm_core.sh",
        "prepare": "husky",
        "app:dev": "concurrently \"vite\" \"electron .\"",
        "app:dist": "vite build --mode electron && node electron/builder.ts",
        "test": "vitest run"
    },
    "desktopName": "com.spessasus.SpessaFont",
    "dependencies": {
        "electron-updater": "^6.8.11"
    },
    "devDependencies": {
        "@babel/core": "^7.29.13",
        "@eslint/js": "^10.0.1",
        "@rolldown/plugin-babel": "^0.3.0",
        "@tanstack/react-virtual": "^3.14.25",
        "@testing-library/react": "^16.3.3",
        "@types/node": "^26.6.5",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@types/serviceworker": "^0.0.203",
        "@types/wicg-file-system-access": "^2023.10.7",
        "@vitejs/plugin-react": "^6.2.1",
        "babel-plugin-react-compiler": "^1.0.0",
        "concurrently": "^10.0.6",
        "electron": "^45.0.0",
        "electron-builder": "^26.18.0",
        "eslint": "^10.13.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.7",
        "eslint-plugin-unicorn": "^79.0.0",
        "globals": "^17.14.0",
        "husky": "^9.1.7",
        "i18next": "^26.7.1",
        "jsdom": "^30.1.3",
        "lint-staged": "^17.6.0",
        "prettier": "^3.9.10",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-hot-toast": "^2.6.1",
        "react-i18next": "^17.1.11",
        "spessasynth_core": "latest",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.1",
        "typescript7": "npm:typescript@^7.0.2",
        "vite": "^8.3.5",
        "vitest": "^5.1.0",
        "wasm-media-encoders": "^0.7.0"
    },
    "overrides": {
        "minimatch": "^11.0.4"
    },
    "lint-staged": {
        "*.{ts,tsx}": [
            "prettier --write",
            "eslint --cache --fix"
        ],
        "*.{json,css,html,md,yml,yaml}": "prettier --write"
    },
    "allowScripts": {
        "electron-winstaller@5.4.0": true
    }
}
