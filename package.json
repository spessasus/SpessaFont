{
    "name": "spessafont",
    "productName": "SpessaFont",
    "description": "Online and open source SF2/DLS sound bank editor",
    "author": {
        "name": "spessasus",
        "email": "spesekspesek@gmail.com"
    },
    "homepage": "https://github.com/spessasus/SpessaFont",
    "repository": "github:spessasus/SpessaFont",
    "private": true,
    "version": "1.4.17",
    "type": "module",
    "main": "electron/main.js",
    "scripts": {
        "dev": "vite",
        "build": "npm run test:types && npm run build:fast",
        "build:fast": "vite build",
        "test:types": "eslint . && tsc -b",
        "preview": "vite preview",
        "debug": "debug_scripts/local_core.sh",
        "release": "debug_scripts/npm_core.sh",
        "prepare": "husky",
        "app:dev": "concurrently \"vite\" \"electron .\"",
        "app:dist": "vite build && node electron/builder.ts"
    },
    "desktopName": "com.spessasus.SpessaFont",
    "dependencies": {
        "@tanstack/react-virtual": "^3.14.23",
        "electron-updater": "^6.8.11",
        "i18next": "^26.5.11",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-hot-toast": "^2.6.1",
        "react-i18next": "^17.1.9",
        "spessasynth_core": "latest"
    },
    "devDependencies": {
        "@electron/typescript-definitions": "^9.2.1",
        "@eslint/js": "^10.0.1",
        "@types/node": "^26.6.5",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@types/serviceworker": "^0.0.203",
        "@types/wicg-file-system-access": "^2023.10.7",
        "@vitejs/plugin-react-swc": "^4.3.3",
        "concurrently": "^10.0.6",
        "cross-env": "^10.1.0",
        "electron": "^45.0.0",
        "electron-builder": "^26.18.0",
        "eslint": "^10.13.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.7",
        "eslint-plugin-unicorn": "^79.0.0",
        "globals": "^17.13.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.6.0",
        "prettier": "^3.9.10",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.1",
        "vite": "^8.3.5",
        "wait-on": "^9.5.1"
    },
    "overrides": {
        "axios": "^1.18.0",
        "brace-expansion": "^5.0.8",
        "builder-util-runtime": "^9.7.0",
        "fast-uri": "^4.1.1",
        "minimatch": "^10.2.6",
        "postcss": "^8.5.25",
        "shell-quote": "^1.10.0",
        "tar": "^7.5.22"
    },
    "lint-staged": {
        "*.{ts,tsx}": [
            "prettier --write",
            "eslint --cache --fix"
        ],
        "*.{json,css,html,md,yml,yaml}": "prettier --write"
    },
    "trustedDependencies": [
        "@swc/core"
    ],
    "allowScripts": {
        "electron-winstaller@5.4.0": true,
        "@swc/core@1.16.20": true
    }
}
